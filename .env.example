# Staging-only backup inputs: use a separate backup-only authority and a
# restricted local destination. Do not commit their local values.
DATABASE_BACKUP_URL=postgresql://backup-user:replace-locally@127.0.0.1:5432/replace-locally
M2_BACKUP_DIRECTORY=replace-locally
# Staging-only M2.4 restore-rehearsal inputs identify a disposable loopback
# recovery target. Never point them at active staging or reuse source access.
DATABASE_RESTORE_URL=postgresql://restore-user:replace-locally@127.0.0.1:replace-locally/replace-locally
M2_RECOVERY_PLATFORM_URL=postgresql://recovery-platform:replace-locally@127.0.0.1:replace-locally/replace-locally
M2_RECOVERY_DATABASE=replace-locally
M2_RECOVERY_PLATFORM_USER=replace-locally
M2_RECOVERY_PLATFORM_PASSWORD=replace-locally
M2_RECOVERY_PORT=replace-locally
M2_RECOVERY_DATA_DIRECTORY=replace-locally
M2_RECOVERY_EVIDENCE_DIRECTORY=replace-locally
M2_RECOVERY_BACKUP_EVIDENCE_REFERENCE=replace-locally
POSTGRES_DATABASE=replace-locally
POSTGRES_SUPERUSER=replace-locally
POSTGRES_SUPERUSER_PASSWORD=replace-locally
APP_VERSION=0.1.0
